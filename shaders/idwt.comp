#extension GL_EXT_control_flow_attributes : require
#if FP16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

layout(local_size_x = 64) in;
layout(constant_id = 0) const bool DCShift = false;
layout(constant_id = 1) const float RangeScale = 1.0;

uint local_index;

#include "dwt_common.h"

layout(set = 0, binding = 0) uniform mediump sampler2DArray uTexture;
layout(set = 0, binding = 1) writeonly mediump uniform image2D uOutput;

layout(push_constant) uniform Registers
{
    ivec2 resolution;
    vec2 inv_resolution;
};

void gather_2x2(ivec2 coord, out VEC4 texels0, out VEC4 texels1, out VEC4 texels2, out VEC4 texels3)
{
    ivec2 coord_even = (coord - ivec2(lessThan(coord, ivec2(0)))) + 1;
    ivec2 coord_odd = (coord + 1) + ivec2(greaterThanEqual(coord + 1, resolution));
    vec2 uv_even = vec2(coord_even) * inv_resolution;
    vec2 uv_odd = vec2(coord_odd) * inv_resolution;

    // Transpose on load.
    texels0 = VEC4(textureGather(uTexture, vec3(uv_even.y, uv_even.x, 0.0), 0)).wxzy;
    texels1 = VEC4(textureGather(uTexture, vec3(uv_even.y, uv_odd.x, 2.0), 0)).wxzy;
    texels2 = VEC4(textureGather(uTexture, vec3(uv_odd.y, uv_even.x, 1.0), 0)).wxzy;
    texels3 = VEC4(textureGather(uTexture, vec3(uv_odd.y, uv_odd.x, 3.0), 0)).wxzy;
}

void write_shared_4x4(ivec2 coord, VEC4 texels0, VEC4 texels1, VEC4 texels2, VEC4 texels3)
{
    store_shared(coord.y + 0, 2 * coord.x + 0, VEC2(texels0.x, texels2.x));
    store_shared(coord.y + 0, 2 * coord.x + 1, VEC2(texels1.x, texels3.x));
    store_shared(coord.y + 0, 2 * coord.x + 2, VEC2(texels0.y, texels2.y));
    store_shared(coord.y + 0, 2 * coord.x + 3, VEC2(texels1.y, texels3.y));
    store_shared(coord.y + 1, 2 * coord.x + 0, VEC2(texels0.z, texels2.z));
    store_shared(coord.y + 1, 2 * coord.x + 1, VEC2(texels1.z, texels3.z));
    store_shared(coord.y + 1, 2 * coord.x + 2, VEC2(texels0.w, texels2.w));
    store_shared(coord.y + 1, 2 * coord.x + 3, VEC2(texels1.w, texels3.w));
}

void load_image_with_apron()
{
    ivec2 base_coord = ivec2(gl_WorkGroupID.xy) * ivec2(BLOCK_SIZE_HALF) - APRON_HALF;
    ivec2 local_coord0 = 2 * unswizzle8x8(local_index);

    VEC4 texels0, texels1, texels2, texels3;
    gather_2x2(base_coord + local_coord0, texels0, texels1, texels2, texels3);
    write_shared_4x4(local_coord0, texels0, texels1, texels2, texels3);

    // Pack the 20 right-apron (including corner) and 16 bottom-apron gathers
    // into one branch so warp 0 runs fully occupied instead of two narrow waves.
    if (local_index < 36u)
    {
        ivec2 local_coord;
        if (local_index < 20u)
        {
            local_coord = ivec2(BLOCK_SIZE_HALF + 2 * int(local_index & 1u), 2 * int(local_index >> 1));
        }
        else
        {
            uint idx = local_index - 20u;
            local_coord = ivec2(2 * int(idx >> 1), BLOCK_SIZE_HALF + 2 * int(idx & 1u));
        }

        gather_2x2(base_coord + local_coord, texels0, texels1, texels2, texels3);
        write_shared_4x4(local_coord, texels0, texels1, texels2, texels3);
    }

    barrier();
}

// Element 0 is never read by any CDF 9/7 inverse lifting step (only indices 1..PADDED_SIZE-1 are).
#define LOAD_AND_INVERSE_LIFT_97(values, local_coord, PADDED_SIZE) \
    values[1] = load_shared((local_coord).y, (local_coord).x + 1) * inv_K; \
    [[unroll]] for (int i = 2; i < (PADDED_SIZE); i += 2) \
    { \
        VEC2 v0 = load_shared((local_coord).y, (local_coord).x + i + 0); \
        VEC2 v1 = load_shared((local_coord).y, (local_coord).x + i + 1); \
        values[i + 0] = v0 * K; \
        values[i + 1] = v1 * inv_K; \
    } \
    [[unroll]] for (int i = 2; i < (PADDED_SIZE) - 1; i += 2) \
        values[i] -= DELTA * (values[i - 1] + values[i + 1]); \
    [[unroll]] for (int i = 3; i < (PADDED_SIZE) - 2; i += 2) \
        values[i] -= GAMMA * (values[i - 1] + values[i + 1]); \
    [[unroll]] for (int i = 4; i < (PADDED_SIZE) - 3; i += 2) \
        values[i] -= BETA * (values[i - 1] + values[i + 1]); \
    [[unroll]] for (int i = 5; i < (PADDED_SIZE) - 4; i += 2) \
        values[i] -= ALPHA * (values[i - 1] + values[i + 1])

void load_and_lift_8x2(ivec2 local_coord, out VEC2 out_values[8])
{
    const int SIZE = 8;
    const int PADDED_SIZE = SIZE + 2 * APRON;
    VEC2 values[PADDED_SIZE];

    LOAD_AND_INVERSE_LIFT_97(values, local_coord, PADDED_SIZE);

    [[unroll]] for (int i = 0; i < SIZE; i++)
        out_values[i] = values[2 * APRON_HALF + i];
}

void store_transposed_8x2(ivec2 local_coord, VEC2 values[8])
{
    [[unroll]] for (int i = 0; i < 4; i++)
    {
        VEC2 a = values[2 * i + 0];
        VEC2 b = values[2 * i + 1];

        // Transpose the 2x2 block.
        VEC2 t0 = VEC2(a.x, b.x);
        VEC2 t1 = VEC2(a.y, b.y);

        // Transpose write
        int y_coord = (local_coord.x >> 1) + i;
        store_shared(y_coord, 2 * local_coord.y + 0, t0);
        store_shared(y_coord, 2 * local_coord.y + 1, t1);
    }
}

void inverse_transform4x2_no_barrier(int y_offset)
{
    const int SIZE = 4;
    const int PADDED_SIZE = SIZE + 2 * APRON;
    VEC2 values[PADDED_SIZE];

    ivec2 local_coord = ivec2(4 * (local_index % 8u), local_index / 8u + y_offset);

    LOAD_AND_INVERSE_LIFT_97(values, local_coord, PADDED_SIZE);

    [[unroll]] for (int i = 0; i < 2; i++)
    {
        VEC2 a = values[2 * APRON_HALF + 2 * i + 0];
        VEC2 b = values[2 * APRON_HALF + 2 * i + 1];

        // Transpose the 2x2 block.
        VEC2 t0 = VEC2(a.x, b.x);
        VEC2 t1 = VEC2(a.y, b.y);

        // Transpose write
        int y_coord = (local_coord.x >> 1) + i;
        store_shared(y_coord, 2 * local_coord.y + 0, t0);
        store_shared(y_coord, 2 * local_coord.y + 1, t1);
    }
}

void main()
{
    local_index = gl_LocalInvocationIndex;

    load_image_with_apron();

    ivec2 local_coord = ivec2(8 * (local_index % 4u), local_index / 4u);

    // Horizontal transform: 8x2 reads rows 0..15, writes [0..15][0..31];
    // 4x2 reads rows 16..19, writes [0..15][32..39]. After the 8x2 read barrier,
    // [0..15][32..39] is dead and [16..19] is untouched, so 4x2 needs no barrier.
    VEC2 h_vals[8];
    load_and_lift_8x2(local_coord, h_vals);

    // Avoid WAR hazard for rows 0..15.
    barrier();

    store_transposed_8x2(local_coord, h_vals);

    if (local_index < 32u)
        inverse_transform4x2_no_barrier(BLOCK_SIZE_HALF);

    barrier();

    // Vertical transform writes directly to uOutput, avoiding a final shared
    // round-trip and barrier.
    VEC2 v_vals[8];
    load_and_lift_8x2(local_coord, v_vals);

    ivec2 out_base = BLOCK_SIZE * ivec2(gl_WorkGroupID.yx);
    [[unroll]] for (int i = 0; i < 4; i++)
    {
        VEC2 a = v_vals[2 * i + 0];
        VEC2 b = v_vals[2 * i + 1];
        if (DCShift)
        {
            a += FLOAT(0.5);
            b += FLOAT(0.5);
        }
        if (RangeScale != 1.0)
        {
            a = clamp(a, FLOAT(0.0), FLOAT(1.0)) * FLOAT(RangeScale);
            b = clamp(b, FLOAT(0.0), FLOAT(1.0)) * FLOAT(RangeScale);
        }
        int out_x = local_coord.x + 2 * i;
        int out_y = 2 * local_coord.y;
        imageStore(uOutput, out_base + ivec2(out_x + 0, out_y + 0), a.xxxx);
        imageStore(uOutput, out_base + ivec2(out_x + 1, out_y + 0), b.xxxx);
        imageStore(uOutput, out_base + ivec2(out_x + 0, out_y + 1), a.yyyy);
        imageStore(uOutput, out_base + ivec2(out_x + 1, out_y + 1), b.yyyy);
    }
}
