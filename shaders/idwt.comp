layout(local_size_x = 64) in;
layout(constant_id = 0) const bool DCShift = false;
layout(constant_id = 1) const float RangeScale = 1.0;
layout(constant_id = 2) const bool EdgePass = false;
layout(constant_id = 3) const uint ActiveBandMask = 7u; // bit0=band1(LH), bit1=band2(HL), bit2=band3(HH)
layout(constant_id = 4) const bool IndirectList = false;
layout(constant_id = 5) const bool MaskCheck = true;
layout(constant_id = 6) const bool SubgroupBallotMask = true;

uint local_index;

#include "dwt_common.h"

#if PRECISION == 0
#define IMG_PRECISION mediump
#else
#define IMG_PRECISION highp
#endif

#if PACKED_INPUT
layout(set = 0, binding = 0) uniform IMG_PRECISION texture2DArray uTexture;
layout(set = 0, binding = 1) writeonly IMG_PRECISION uniform image2D uOutput;
layout(set = 0, binding = 2) readonly buffer PayloadOffsets
{
    uint data[];
} payload_offsets;
layout(set = 0, binding = 3) readonly buffer WgList
{
    uint data[];
} wg_list;
#else
layout(set = 0, binding = 0) uniform IMG_PRECISION sampler2DArray uTexture;
layout(set = 0, binding = 1) writeonly IMG_PRECISION uniform image2D uOutput;
#endif

layout(push_constant) uniform Registers
{
    ivec2 resolution;
    vec2 inv_resolution;
#if PACKED_INPUT
    int block_offset_32x32;
    int block_stride_32x32;
    int band_stride_32x32;
    int wg_offset_x;
    int wg_offset_y;
#endif
};

void write_shared_4x4(ivec2 coord, VEC4 texels0, VEC4 texels1, VEC4 texels2, VEC4 texels3)
{
    store_shared(coord.y + 0, 2 * coord.x + 0, VEC2(texels0.x, texels2.x));
    store_shared(coord.y + 0, 2 * coord.x + 1, VEC2(texels1.x, texels3.x));
    store_shared(coord.y + 0, 2 * coord.x + 2, VEC2(texels0.y, texels2.y));
    store_shared(coord.y + 0, 2 * coord.x + 3, VEC2(texels1.y, texels3.y));
    store_shared(coord.y + 1, 2 * coord.x + 0, VEC2(texels0.z, texels2.z));
    store_shared(coord.y + 1, 2 * coord.x + 1, VEC2(texels1.z, texels3.z));
    store_shared(coord.y + 1, 2 * coord.x + 2, VEC2(texels0.w, texels2.w));
    store_shared(coord.y + 1, 2 * coord.x + 3, VEC2(texels1.w, texels3.w));
}

#if PACKED_INPUT
ivec2 workgroup_xy()
{
    if (IndirectList)
    {
        uint packed = wg_list.data[gl_WorkGroupID.x + uint(wg_offset_x)];
        return ivec2(int(packed & 0xffffu), int(packed >> 16));
    }
    return ivec2(gl_WorkGroupID.xy) + ivec2(wg_offset_x, wg_offset_y);
}

uint compute_band_mask_scalar(int layer, int bx0, int bx1, int by0, int by1)
{
    int base = block_offset_32x32 + (layer - 1) * band_stride_32x32;
    int r0 = base + by0 * block_stride_32x32;
    int r1 = base + by1 * block_stride_32x32;
    uint m = 0u;
    m |= uint(payload_offsets.data[r0 + bx0] != ~0u);
    m |= uint(payload_offsets.data[r0 + bx1] != ~0u) << 1;
    m |= uint(payload_offsets.data[r1 + bx0] != ~0u) << 2;
    m |= uint(payload_offsets.data[r1 + bx1] != ~0u) << 3;
    return m;
}

int mirror_1d(int c, bool is_even, int N)
{
    if (c < 0)
        c = is_even ? -c : (-c - 1);
    else if (c >= N)
        c = is_even ? (2 * N - 1 - c) : (2 * N - 2 - c);
    return clamp(c, 0, N - 1);
}

FLOAT fetch_pixel_edge(int ox, int oy, int layer, uint mask)
{
    if (MaskCheck && layer > 0 && mask != 0xfu)
    {
        int idx = block_offset_32x32 + (layer - 1) * band_stride_32x32 +
                  (oy >> 5) * block_stride_32x32 + (ox >> 5);
        if (payload_offsets.data[idx] == ~0u)
            return FLOAT(0.0);
    }
    vec4 q = texelFetch(uTexture, ivec3(ox >> 1, oy >> 1, layer), 0);
    vec2 row = ((oy & 1) == 0) ? q.xy : q.zw;
    return FLOAT(((ox & 1) == 0) ? row.x : row.y);
}

VEC4 fetch_quad_edge_oob(ivec2 c, bool even_x, bool even_y, int layer, uint mask)
{
    if (MaskCheck && layer > 0 && mask == 0u)
        return VEC4(0.0);
    int oy0 = mirror_1d(c.x + 0, even_x, resolution.x);
    int oy1 = mirror_1d(c.x + 1, even_x, resolution.x);
    int ox0 = mirror_1d(c.y + 0, even_y, resolution.y);
    int ox1 = mirror_1d(c.y + 1, even_y, resolution.y);
    return VEC4(
        fetch_pixel_edge(ox0, oy0, layer, mask),
        fetch_pixel_edge(ox0, oy1, layer, mask),
        fetch_pixel_edge(ox1, oy0, layer, mask),
        fetch_pixel_edge(ox1, oy1, layer, mask));
}

void load_tile_all(ivec2 base_coord, ivec2 lc)
{
    ivec2 c = base_coord + lc;
    ivec2 q = ivec2(c.y >> 1, c.x >> 1);
    VEC4 t0 = VEC4(texelFetch(uTexture, ivec3(q, 0), 0).xzyw);
    VEC4 t1 = VEC4(texelFetch(uTexture, ivec3(q, 2), 0).xzyw);
    VEC4 t2 = VEC4(texelFetch(uTexture, ivec3(q, 1), 0).xzyw);
    VEC4 t3 = VEC4(texelFetch(uTexture, ivec3(q, 3), 0).xzyw);
    write_shared_4x4(lc, t0, t1, t2, t3);
}

void load_tile_ll(ivec2 base_coord, ivec2 lc)
{
    ivec2 c = base_coord + lc;
    ivec2 q = ivec2(c.y >> 1, c.x >> 1);
    VEC4 t0 = VEC4(texelFetch(uTexture, ivec3(q, 0), 0).xzyw);
    write_shared_4x4(lc, t0, VEC4(0.0), VEC4(0.0), VEC4(0.0));
}

void load_tile_mixed(ivec2 base_coord, ivec2 lc, uint mask1, uint mask2, uint mask3, int bx0, int by0)
{
    ivec2 c = base_coord + lc;
    ivec2 q = ivec2(c.y >> 1, c.x >> 1);
    uint bit_mask = 1u << (uint((q.x >> 4) != bx0) | (uint((q.y >> 4) != by0) << 1));
    VEC4 t0 = VEC4(texelFetch(uTexture, ivec3(q, 0), 0).xzyw);
    VEC4 t1 = ((ActiveBandMask & 2u) != 0u && (mask2 & bit_mask) != 0u) ? VEC4(texelFetch(uTexture, ivec3(q, 2), 0).xzyw) : VEC4(0.0);
    VEC4 t2 = ((ActiveBandMask & 1u) != 0u && (mask1 & bit_mask) != 0u) ? VEC4(texelFetch(uTexture, ivec3(q, 1), 0).xzyw) : VEC4(0.0);
    VEC4 t3 = ((ActiveBandMask & 4u) != 0u && (mask3 & bit_mask) != 0u) ? VEC4(texelFetch(uTexture, ivec3(q, 3), 0).xzyw) : VEC4(0.0);
    write_shared_4x4(lc, t0, t1, t2, t3);
}

void load_image_with_apron(ivec2 wg)
{
    ivec2 base_coord = wg * ivec2(BLOCK_SIZE_HALF) - APRON_HALF;
    ivec2 local_coord0 = 2 * unswizzle8x8(local_index);
    ivec2 local_coord_horiz = ivec2(BLOCK_SIZE_HALF + 2 * (local_index % 2u), 2 * (local_index / 2u));
    ivec2 local_coord_vert = local_coord_horiz.yx;

    int bx0 = 0, by0 = 0;
    uint mask1 = 0xfu, mask2 = 0xfu, mask3 = 0xfu;
    if (ActiveBandMask != 0u && (EdgePass || MaskCheck))
    {
        int oy_min = max(base_coord.x, 0);
        int oy_max = min(base_coord.x + 19, resolution.x - 1);
        int ox_min = max(base_coord.y, 0);
        int ox_max = min(base_coord.y + 19, resolution.y - 1);
        bx0 = ox_min >> 5;
        int bx1 = ox_max >> 5;
        by0 = oy_min >> 5;
        int by1 = oy_max >> 5;

        if (SubgroupBallotMask || gl_SubgroupSize >= 12u)
        {
            uint lid = gl_SubgroupInvocationID;
            bool active_blk = false;
            if (lid < 12u)
            {
                int band = int(lid >> 2);
                int corner = int(lid & 3u);
                int cx = ((corner & 1) == 0) ? bx0 : bx1;
                int cy = ((corner & 2) == 0) ? by0 : by1;
                active_blk = payload_offsets.data[block_offset_32x32 + band * band_stride_32x32 + cy * block_stride_32x32 + cx] != ~0u;
            }
            uint all_masks = subgroupBallot(active_blk).x;
            mask1 = ((ActiveBandMask & 1u) != 0u) ? (all_masks & 0xfu) : 0u;
            mask2 = ((ActiveBandMask & 2u) != 0u) ? ((all_masks >> 4) & 0xfu) : 0u;
            mask3 = ((ActiveBandMask & 4u) != 0u) ? ((all_masks >> 8) & 0xfu) : 0u;
        }
        else
        {
            mask1 = ((ActiveBandMask & 1u) != 0u) ? compute_band_mask_scalar(1, bx0, bx1, by0, by1) : 0u;
            mask2 = ((ActiveBandMask & 2u) != 0u) ? compute_band_mask_scalar(2, bx0, bx1, by0, by1) : 0u;
            mask3 = ((ActiveBandMask & 4u) != 0u) ? compute_band_mask_scalar(3, bx0, bx1, by0, by1) : 0u;
        }
    }

    bool wg_interior = !EdgePass || (base_coord.x >= 0 && base_coord.x + 19 < resolution.x &&
                                     base_coord.y >= 0 && base_coord.y + 19 < resolution.y);

    if (wg_interior)
    {
        if (ActiveBandMask == 0u || (MaskCheck && (mask1 | mask2 | mask3) == 0u))
        {
            load_tile_ll(base_coord, local_coord0);
            if (local_coord_horiz.y < BLOCK_SIZE_HALF + 2 * APRON_HALF)
                load_tile_ll(base_coord, local_coord_horiz);
            if (local_coord_vert.x < BLOCK_SIZE_HALF)
                load_tile_ll(base_coord, local_coord_vert);
        }
        else if (ActiveBandMask == 7u && (!MaskCheck || (mask1 & mask2 & mask3) == 0xfu))
        {
            load_tile_all(base_coord, local_coord0);
            if (local_coord_horiz.y < BLOCK_SIZE_HALF + 2 * APRON_HALF)
                load_tile_all(base_coord, local_coord_horiz);
            if (local_coord_vert.x < BLOCK_SIZE_HALF)
                load_tile_all(base_coord, local_coord_vert);
        }
        else
        {
            load_tile_mixed(base_coord, local_coord0, mask1, mask2, mask3, bx0, by0);
            if (local_coord_horiz.y < BLOCK_SIZE_HALF + 2 * APRON_HALF)
                load_tile_mixed(base_coord, local_coord_horiz, mask1, mask2, mask3, bx0, by0);
            if (local_coord_vert.x < BLOCK_SIZE_HALF)
                load_tile_mixed(base_coord, local_coord_vert, mask1, mask2, mask3, bx0, by0);
        }
    }
    else
    {
        [[dont_unroll]]
        for (int pass = 0; pass < 3; pass++)
        {
            ivec2 lc = (pass == 0) ? local_coord0 : ((pass == 1) ? local_coord_horiz : local_coord_vert);
            if (pass == 1 && lc.y >= BLOCK_SIZE_HALF + 2 * APRON_HALF) continue;
            if (pass == 2 && lc.x >= BLOCK_SIZE_HALF) continue;

            ivec2 c = base_coord + lc;
            VEC4 t0, t1, t2, t3;
            if (c.x >= 0 && c.x <= resolution.x - 2 && c.y >= 0 && c.y <= resolution.y - 2)
            {
                ivec2 q = ivec2(c.y >> 1, c.x >> 1);
                t0 = VEC4(texelFetch(uTexture, ivec3(q, 0), 0).xzyw);
                if (!MaskCheck && ActiveBandMask == 7u)
                {
                    t1 = VEC4(texelFetch(uTexture, ivec3(q, 2), 0).xzyw);
                    t2 = VEC4(texelFetch(uTexture, ivec3(q, 1), 0).xzyw);
                    t3 = VEC4(texelFetch(uTexture, ivec3(q, 3), 0).xzyw);
                }
                else
                {
                    uint bm = 1u << (uint((q.x >> 4) != bx0) | (uint((q.y >> 4) != by0) << 1));
                    t1 = ((ActiveBandMask & 2u) != 0u && (!MaskCheck || (mask2 & bm) != 0u)) ? VEC4(texelFetch(uTexture, ivec3(q, 2), 0).xzyw) : VEC4(0.0);
                    t2 = ((ActiveBandMask & 1u) != 0u && (!MaskCheck || (mask1 & bm) != 0u)) ? VEC4(texelFetch(uTexture, ivec3(q, 1), 0).xzyw) : VEC4(0.0);
                    t3 = ((ActiveBandMask & 4u) != 0u && (!MaskCheck || (mask3 & bm) != 0u)) ? VEC4(texelFetch(uTexture, ivec3(q, 3), 0).xzyw) : VEC4(0.0);
                }
            }
            else
            {
                t0 = fetch_quad_edge_oob(c, true,  true,  0, 0xfu);
                t1 = ((ActiveBandMask & 2u) != 0u) ? fetch_quad_edge_oob(c, false, true,  2, mask2) : VEC4(0.0);
                t2 = ((ActiveBandMask & 1u) != 0u) ? fetch_quad_edge_oob(c, true,  false, 1, mask1) : VEC4(0.0);
                t3 = ((ActiveBandMask & 4u) != 0u) ? fetch_quad_edge_oob(c, false, false, 3, mask3) : VEC4(0.0);
            }
            write_shared_4x4(lc, t0, t1, t2, t3);
        }
    }

    barrier();
}
#else
ivec2 workgroup_xy()
{
    return ivec2(gl_WorkGroupID.xy);
}

vec2 generate_mirror_uv(ivec2 coord, bool even_x, bool even_y)
{
    coord -= ivec2(band(bvec2(even_x, even_y), lessThan(coord, ivec2(0))));
    coord += 1;
    coord += ivec2(band(bvec2(!even_x, !even_y), greaterThanEqual(coord, resolution)));
    vec2 uv = vec2(coord) * inv_resolution;
    return uv.yx; // Transpose on load.
}

void load_image_with_apron(ivec2 wg)
{
    ivec2 base_coord = wg * ivec2(BLOCK_SIZE_HALF) - APRON_HALF;
    ivec2 local_coord0 = 2 * unswizzle8x8(local_index);
    ivec2 coord0 = base_coord + local_coord0;

    // Transpose on load.
    VEC4 texels0 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(coord0, true, true), 0.0), 0)).wxzy;
    VEC4 texels1 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(coord0, false, true), 2.0), 0)).wxzy;
    VEC4 texels2 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(coord0, true, false), 1.0), 0)).wxzy;
    VEC4 texels3 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(coord0, false, false), 3.0), 0)).wxzy;
    write_shared_4x4(local_coord0, texels0, texels1, texels2, texels3);

    ivec2 local_coord_horiz = ivec2(BLOCK_SIZE_HALF + 2 * (local_index % 2u), 2 * (local_index / 2u));
    if (local_coord_horiz.y < BLOCK_SIZE_HALF + 2 * APRON_HALF)
    {
        texels0 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(base_coord + local_coord_horiz, true, true), 0.0), 0)).wxzy;
        texels1 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(base_coord + local_coord_horiz, false, true), 2.0), 0)).wxzy;
        texels2 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(base_coord + local_coord_horiz, true, false), 1.0), 0)).wxzy;
        texels3 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(base_coord + local_coord_horiz, false, false), 3.0), 0)).wxzy;
        write_shared_4x4(local_coord_horiz, texels0, texels1, texels2, texels3);
    }

    ivec2 local_coord_vert = local_coord_horiz.yx;
    if (local_coord_vert.x < BLOCK_SIZE_HALF)
    {
        texels0 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(base_coord + local_coord_vert, true, true), 0.0), 0)).wxzy;
        texels1 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(base_coord + local_coord_vert, false, true), 2.0), 0)).wxzy;
        texels2 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(base_coord + local_coord_vert, true, false), 1.0), 0)).wxzy;
        texels3 = VEC4(textureGather(uTexture, vec3(generate_mirror_uv(base_coord + local_coord_vert, false, false), 3.0), 0)).wxzy;
        write_shared_4x4(local_coord_vert, texels0, texels1, texels2, texels3);
    }

    barrier();
}
#endif

void inverse_transform8x2()
{
    const int SIZE = 8;
    const int PADDED_SIZE = SIZE + 2 * APRON;
    const int PADDED_SIZE_HALF = PADDED_SIZE / 2;
    VEC2 values[PADDED_SIZE];

    ivec2 local_coord = ivec2(8 * (local_index % 4u), local_index / 4u);

    for (int i = 0; i < PADDED_SIZE; i += 2)
    {
        VEC2 v0 = load_shared(local_coord.y, local_coord.x + i + 0);
        VEC2 v1 = load_shared(local_coord.y, local_coord.x + i + 1);
        values[i + 0] = v0 * K;
        values[i + 1] = v1 * inv_K;
    }

    // CDF 9/7 lifting steps.
    // Arith go brrr.
    for (int i = 2; i < PADDED_SIZE - 1; i += 2)
        values[i] -= DELTA * (values[i - 1] + values[i + 1]);
    for (int i = 3; i < PADDED_SIZE - 2; i += 2)
        values[i] -= GAMMA * (values[i - 1] + values[i + 1]);
    for (int i = 4; i < PADDED_SIZE - 3; i += 2)
        values[i] -= BETA * (values[i - 1] + values[i + 1]);
    for (int i = 5; i < PADDED_SIZE - 4; i += 2)
        values[i] -= ALPHA * (values[i - 1] + values[i + 1]);

    // Avoid WAR hazard.
    barrier();

    for (int i = APRON_HALF; i < PADDED_SIZE_HALF - APRON_HALF; i++)
    {
        VEC2 a = values[2 * i + 0];
        VEC2 b = values[2 * i + 1];

        // Transpose the 2x2 block.
        VEC2 t0 = VEC2(a.x, b.x);
        VEC2 t1 = VEC2(a.y, b.y);

        // Transpose write
        int y_coord = (local_coord.x >> 1) + (i - APRON_HALF);
        store_shared(y_coord, 2 * local_coord.y + 0, t0);
        store_shared(y_coord, 2 * local_coord.y + 1, t1);
    }
}

void inverse_transform4x2(bool active_lane, int y_offset)
{
    const int SIZE = 4;
    const int PADDED_SIZE = SIZE + 2 * APRON;
    const int PADDED_SIZE_HALF = PADDED_SIZE / 2;
    VEC2 values[PADDED_SIZE];

    ivec2 local_coord = ivec2(4 * (local_index % 8u), local_index / 8u + y_offset);

    if (active_lane)
    {
        for (int i = 0; i < PADDED_SIZE; i += 2)
        {
            VEC2 v0 = load_shared(local_coord.y, local_coord.x + i + 0);
            VEC2 v1 = load_shared(local_coord.y, local_coord.x + i + 1);
            values[i + 0] = v0 * K;
            values[i + 1] = v1 * inv_K;
        }

        // CDF 9/7 lifting steps.
        // Arith go brrr.
        for (int i = 2; i < PADDED_SIZE - 1; i += 2)
            values[i] -= DELTA * (values[i - 1] + values[i + 1]);
        for (int i = 3; i < PADDED_SIZE - 2; i += 2)
            values[i] -= GAMMA * (values[i - 1] + values[i + 1]);
        for (int i = 4; i < PADDED_SIZE - 3; i += 2)
            values[i] -= BETA * (values[i - 1] + values[i + 1]);
        for (int i = 5; i < PADDED_SIZE - 4; i += 2)
            values[i] -= ALPHA * (values[i - 1] + values[i + 1]);
    }

    if (active_lane)
    {
        // Apron source rows and transposed destination rows are disjoint. The
        // main transform's barrier already finished reads of these columns.
        for (int i = APRON_HALF; i < PADDED_SIZE_HALF - APRON_HALF; i++)
        {
            VEC2 a = values[2 * i + 0];
            VEC2 b = values[2 * i + 1];

            // Transpose the 2x2 block.
            VEC2 t0 = VEC2(a.x, b.x);
            VEC2 t1 = VEC2(a.y, b.y);

            // Transpose write
            int y_coord = (local_coord.x >> 1) + (i - APRON_HALF);
            store_shared(y_coord, 2 * local_coord.y + 0, t0);
            store_shared(y_coord, 2 * local_coord.y + 1, t1);
        }
    }
}

void main()
{
    local_index = gl_LocalInvocationIndex;
    ivec2 wg = workgroup_xy();

    load_image_with_apron(wg);

    // Horizontal transform.
    inverse_transform8x2();

    // Also need to transform the apron.
    inverse_transform4x2(local_index < 32, BLOCK_SIZE_HALF);

    barrier();

    // Vertical transform.
    inverse_transform8x2();

    barrier();

    ivec2 local_coord = unswizzle8x8(local_index);

#if PACKED_OUTPUT
    for (int y = local_coord.y; y < BLOCK_SIZE_HALF; y += 8)
    {
        for (int qy = local_coord.x; qy < BLOCK_SIZE_HALF; qy += 8)
        {
            VEC2 v0 = load_shared(y, 2 * qy + 0);
            VEC2 v1 = load_shared(y, 2 * qy + 1);
            imageStore(uOutput, ivec2(y, qy) + BLOCK_SIZE_HALF * wg.yx,
                       vec4(v0.x, v0.y, v1.x, v1.y));
        }
    }
#else
    for (int y = local_coord.y; y < BLOCK_SIZE_HALF; y += 8)
    {
        for (int x = local_coord.x; x < BLOCK_SIZE; x += 8)
        {
            VEC2 v = load_shared(y, x);
            if (DCShift)
                v += FLOAT(0.5);
            if (RangeScale != 1.0)
                v = clamp(v, FLOAT(0.0), FLOAT(1.0)) * FLOAT(RangeScale);
            imageStore(uOutput, ivec2(2 * y + 0, x) + BLOCK_SIZE * wg.yx, v.xxxx);
            imageStore(uOutput, ivec2(2 * y + 1, x) + BLOCK_SIZE * wg.yx, v.yyyy);
        }
    }
#endif
}
